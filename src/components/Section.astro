---
interface Props {
    title: string;
    subtitle: string;
    image: string;
    imageAlt?: string;
    reverse?: boolean;
    ctaText?: string;
    ctaLink?: string;
}

const { title, subtitle, image, imageAlt = "Section Image", reverse = false, ctaText, ctaLink } = Astro.props;
---

<section class="py-20 md:py-32 px-6 overflow-hidden" id="Section">
    <div class={`max-w-6xl mx-auto flex flex-col md:flex-row items-center gap-12 md:gap-20 ${reverse ? 'md:flex-row-reverse' : ''}`}>
        
        <!-- Image Side -->
        <div class="w-full md:w-1/2 reveal-on-scroll opacity-0 translate-y-8 transition-all duration-1000 ease-out">
            <div class="relative rounded-2xl overflow-hidden shadow-2xl shadow-gray-200 aspect-[4/3] group">
                <img src={image} alt={imageAlt} class="object-cover w-full h-full transform transition-transform duration-700 group-hover:scale-105" />
                <div class="absolute inset-0 bg-black/5 group-hover:bg-transparent transition-colors duration-500"></div>
            </div>
        </div>

        <!-- Text Side -->
        <div class="w-full md:w-1/2 text-left reveal-on-scroll opacity-0 translate-y-8 transition-all duration-1000 ease-out delay-200">
            <h2 class="font-serif text-4xl md:text-5xl text-gray-800 mb-6 leading-tight">{title}</h2>
            <p class="text-lg text-gray-600 mb-8 font-light leading-relaxed">{subtitle}</p>
            {ctaText && ctaLink && (
                <a href={ctaLink} class="inline-flex items-center text-accent font-medium hover:text-green-600 transition-colors group">
                    {ctaText}
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5 ml-2 transform group-hover:translate-x-1 transition-transform">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25L21 12m0 0l-3.75 3.75M21 12H3" />
                    </svg>
                </a>
            )}
        </div>
    </div>
</section>
