---
const currentYear = new Date().getFullYear();
---

<footer class="bg-gray-900 text-white py-12 px-6">
    <div class="max-w-6xl mx-auto flex flex-col md:flex-row justify-between items-center gap-8">
        <div class="flex items-center gap-2">
            <img src="https://hosted.inled.es/inledai.svg" alt="inled ai" class="h-6 w-auto brightness-0 invert" />
            <span class="font-serif text-lg tracking-wide">inled ai</span>
        </div>
        
        <div class="flex gap-8 text-gray-400 text-sm">
            <a href="#" class="hover:text-accent transition-colors">Política de Privacidad</a>
            <a href="#" class="hover:text-accent transition-colors">Términos de Uso</a>
            <a href="#" class="hover:text-accent transition-colors">Contacto</a>
        </div>

        <div class="text-gray-500 text-sm">
            &copy; {currentYear} Inled AI. Todos los derechos reservados.
        </div>
    </div>
</footer>
