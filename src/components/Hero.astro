---
---

<section class="relative h-screen flex flex-col justify-center items-center text-center px-4 overflow-hidden pt-20">
    <!-- Abstract Background -->
    <div class="absolute top-0 left-0 w-full h-full overflow-hidden -z-10 pointer-events-none">
        <div class="absolute top-[-10%] left-[-10%] w-[40%] h-[40%] bg-orange-200/50 rounded-full blur-[100px] opacity-60"></div>
        <div class="absolute top-[20%] right-[-5%] w-[30%] h-[50%] bg-rose-200/40 rounded-full blur-[80px] opacity-60"></div>
        <div class="absolute bottom-[-10%] left-[20%] w-[50%] h-[40%] bg-amber-100/60 rounded-full blur-[100px] opacity-60"></div>
    </div>

    <div class="max-w-4xl mx-auto z-10">
        <h1 class="font-serif text-6xl md:text-8xl italic text-gray-800 mb-6 animate-fade-in-up leading-tight">
            IA <br/>
            <span class="not-italic">privada</span>
        </h1>
        <p class="text-xl md:text-2xl text-gray-600 mb-10 max-w-2xl mx-auto animate-fade-in-up animate-delay-100 font-light">
            Respetuosa con tu privacidad, gratuita e ilimitada
        </p>
        
        <div class="animate-fade-in-up animate-delay-200">
             <a href="#Section" class="inline-block px-8 py-3 bg-accent text-white font-medium rounded-full hover:bg-opacity-90 transition-all hover:scale-105 shadow-lg shadow-accent/30">
                Comenzar ahora
            </a>
        </div>
    </div>
    
    <!-- Scroll indicator -->
    <div class="absolute bottom-10 animate-bounce text-gray-400">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
        </svg>
    </div>
</section>
